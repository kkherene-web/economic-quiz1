<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>General Economic English — Homework Check</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome for Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen py-8 px-4 sm:px-6 lg:px-8">

  <!-- Main Container -->
  <div class="max-w-4xl mx-auto space-y-6">

    <!-- Header Card -->
    <div class="bg-gradient-to-r from-teal-700 to-emerald-800 rounded-2xl p-6 sm:p-8 text-white shadow-xl">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <span class="bg-teal-600/60 text-teal-100 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider">
            General Economic English
          </span>
          <h1 class="text-2xl sm:text-3xl font-bold mt-2">Homework Check — Week 1</h1>
          <p class="text-teal-100 text-sm sm:text-base mt-1">Untimed practice activity & automated submission.</p>
        </div>
        <div class="bg-white/10 backdrop-blur-md rounded-xl p-4 text-center border border-white/10">
          <span class="block text-xs text-teal-200 uppercase font-medium">Total Questions</span>
          <span class="text-2xl font-extrabold text-white">20 Questions</span>
        </div>
      </div>
    </div>

    <!-- Student Details Form Card -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
      <h2 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
        <i class="fa-solid fa-id-card text-teal-600"></i> Student Information
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <label class="block text-xs font-semibold uppercase text-slate-500 mb-1">Full Name <span class="text-rose-500">*</span></label>
          <input type="text" id="studentName" required placeholder="e.g. John Doe" 
                 class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm outline-none transition"/>
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase text-slate-500 mb-1">Student ID <span class="text-rose-500">*</span></label>
          <input type="text" id="studentId" required placeholder="e.g. 2026390123" 
                 class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm outline-none transition"/>
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase text-slate-500 mb-1">Group / Class <span class="text-rose-500">*</span></label>
          <input type="text" id="studentGroup" required placeholder="e.g. Group 02" 
                 class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm outline-none transition"/>
        </div>
      </div>
    </div>

    <!-- Questions Form -->
    <form id="homeworkForm" onsubmit="handleFormSubmit(event)" class="space-y-6">
      <div id="questionsContainer" class="space-y-6">
        <!-- Dynamic Questions Rendered by JS -->
      </div>

      <!-- Action Panel -->
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-xs text-slate-500">
          Make sure all 20 questions are answered before submitting your homework.
        </p>
        <button type="submit" id="submitBtn" 
                class="w-full sm:w-auto px-8 py-3.5 bg-teal-600 hover:bg-teal-700 active:scale-95 text-white font-semibold rounded-xl shadow-lg shadow-teal-600/20 transition-all duration-200 flex items-center justify-center gap-2">
          <i class="fa-solid fa-paper-plane"></i>
          <span>Submit Homework</span>
        </button>
      </div>
    </form>

    <!-- Submission Status Modal / Banner -->
    <div id="statusBanner" class="hidden rounded-2xl p-6 shadow-xl border"></div>

  </div>

  <script>
    /* =====================================================================
       CONFIGURABLE GOOGLE APPS SCRIPT WEB APP URL
       =====================================================================
       Instructions:
       1. Open Google Sheets -> Create spreadsheet named "Homework Check"
       2. Click Extensions -> Apps Script
       3. Paste the provided Script code (see comment block below)
       4. Deploy as Web App (Execute as: Me, Who has access: Anyone)
       5. Paste your Web App URL into GOOGLE_SCRIPT_URL below:
    -------------------------------------------------------------------- */
    const GOOGLE_SCRIPT_URL = "YOUR_GOOGLE_APPS_SCRIPT_WEB_APP_URL_HERE";

    // 20 Economics Questions Data Matrix
    const questionsData = [
      {
        id: 1,
        question: "What is economics primarily about?",
        options: ["Making money", "Choices with limited resources", "Selling products", "Government policies"],
        correct: 1
      },
      {
        id: 2,
        question: "What does \"economy\" refer to?",
        options: ["The economic system of a country", "The study of resources", "A person who manages money", "An adjective meaning economic"],
        correct: 0
      },
      {
        id: 3,
        question: "What does \"economics\" refer to?",
        options: ["The study of how resources are used", "A business activity", "An adjective", "The economic system"],
        correct: 0
      },
      {
        id: 4,
        question: "What part of speech is \"economic\"?",
        options: ["Verb", "Adverb", "Adjective", "Noun"],
        correct: 2
      },
      {
        id: 5,
        question: "Which sentence uses \"economic\" correctly?",
        options: ["The economic is developing.", "This is an economic problem.", "I study economic.", "She works in economic."],
        correct: 1
      },
      {
        id: 6,
        question: "Microeconomics studies:",
        options: ["The economy as a whole", "Only inflation", "Small parts of the economy", "Only unemployment"],
        correct: 2
      },
      {
        id: 7,
        question: "Macroeconomics studies:",
        options: ["One consumer's choice", "The price of one product", "One company's costs", "The economy as a whole"],
        correct: 3
      },
      {
        id: 8,
        question: "Which of the following is a macroeconomics topic?",
        options: ["A consumer's budget", "The price of a phone", "One company's costs", "Inflation in the country"],
        correct: 3
      },
      {
        id: 9,
        question: "Which of the following is a microeconomics topic?",
        options: ["A consumer's choice", "Unemployment", "National inflation", "Economic growth"],
        correct: 0
      },
      {
        id: 10,
        question: "What is the key idea of economics?",
        options: ["Managing people", "Selling products", "Choices with limited resources", "Unlimited resources"],
        correct: 2
      },
      {
        id: 11,
        question: "Which of the following is NOT a resource?",
        options: ["Workers", "Time", "A football match", "Money"],
        correct: 2
      },
      {
        id: 12,
        question: "Which of the following is an example of a resource?",
        options: ["Workers", "A holiday", "A birthday party", "A football match"],
        correct: 0
      },
      {
        id: 13,
        question: "What does English help economics students do?",
        options: ["Only communicate", "Read, communicate, and learn", "Only learn", "Only read"],
        correct: 1
      },
      {
        id: 14,
        question: "What does scarcity mean?",
        options: ["People have no money", "Resources are limited", "Resources are unlimited", "There are no goods"],
        correct: 1
      },
      {
        id: 15,
        question: "Who is a consumer?",
        options: ["A person who makes goods", "A person who buys or uses goods and services", "A person who sells products", "A person who organizes workers"],
        correct: 1
      },
      {
        id: 16,
        question: "Who is a producer?",
        options: ["A person who uses services", "A person who buys food", "A person who plans work", "A person or company that makes goods or provides services"],
        correct: 3
      },
      {
        id: 17,
        question: "Why is English important for economics students?",
        options: ["To pass exams only", "To travel", "To make money", "To read, communicate, and learn"],
        correct: 3
      },
      {
        id: 18,
        question: "Which field studies how resources are used?",
        options: ["Economics", "Management", "Business", "Marketing"],
        correct: 0
      },
      {
        id: 19,
        question: "Which field focuses on producing and selling goods or services?",
        options: ["Business", "Accounting", "Economics", "Management"],
        correct: 0
      },
      {
        id: 20,
        question: "Which field focuses on planning and organizing people and resources?",
        options: ["Management", "Finance", "Economics", "Business"],
        correct: 0
      }
    ];

    // Render Questions dynamically
    function renderQuestions() {
      const container = document.getElementById('questionsContainer');
      container.innerHTML = questionsData.map((q, idx) => `
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5 sm:p-6 transition hover:border-slate-300" id="qContainer_${q.id}">
          <div class="flex items-start justify-between gap-3 mb-4">
            <div class="flex items-center gap-3">
              <span class="flex-shrink-0 w-8 h-8 rounded-xl bg-teal-100 text-teal-800 font-bold text-sm flex items-center justify-center">
                ${idx + 1}
              </span>
              <h3 class="text-base font-semibold text-slate-800">${q.question}</h3>
            </div>
            <button type="button" onclick="speakText('${q.question.replace(/'/g, "\\'")}')" 
                    class="text-slate-400 hover:text-teal-600 p-2 rounded-lg hover:bg-teal-50 transition" title="Listen to question">
              <i class="fa-solid fa-volume-high"></i>
            </button>
          </div>

          <div class="grid grid-cols-1 gap-2.5 pl-0 sm:pl-11">
            ${q.options.map((opt, optIdx) => `
              <label class="flex items-center gap-3 p-3 rounded-xl border border-slate-200 hover:bg-slate-50 cursor-pointer transition text-sm">
                <input type="radio" name="q_${q.id}" value="${optIdx}" required 
                       class="w-4 h-4 text-teal-600 border-slate-300 focus:ring-teal-500">
                <span class="text-slate-700 font-medium">${String.fromCharCode(97 + optIdx)}. ${opt}</span>
              </label>
            `).join('')}
          </div>
        </div>
      `).join('');
    }

    // Text-To-Speech function using Web Speech API
    function speakText(text) {
      if (!('speechSynthesis' in window)) {
        alert("Text-to-speech is not supported on this browser.");
        return;
      }
      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = 'en-US';
      utterance.rate = 0.9;
      window.speechSynthesis.speak(utterance);
    }

    // Handle Homework Submission
    async function handleFormSubmit(e) {
      e.preventDefault();

      const name = document.getElementById('studentName').value.trim();
      const id = document.getElementById('studentId').value.trim();
      const group = document.getElementById('studentGroup').value.trim();

      if (!name || !id || !group) {
        alert("Please complete your Student Details (Name, ID, Group) first.");
        return;
      }

      // Calculate score
      let score = 0;
      const userAnswers = [];

      questionsData.forEach(q => {
        const selected = document.querySelector(`input[name="q_${q.id}"]:checked`);
        const val = selected ? parseInt(selected.value) : -1;
        const isCorrect = (val === q.correct);
        if (isCorrect) score++;

        userAnswers.push({
          questionId: q.id,
          question: q.question,
          studentAnswer: val !== -1 ? q.options[val] : "Unanswered",
          correctAnswer: q.options[q.correct],
          isCorrect: isCorrect
        });
      });

      const percentage = ((score / questionsData.length) * 100).toFixed(1);
      const timestamp = new Date().toLocaleString('en-US');

      // Show UI submitting state
      const submitBtn = document.getElementById('submitBtn');
      submitBtn.disabled = true;
      submitBtn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Submitting...`;

      const statusBanner = document.getElementById('statusBanner');
      statusBanner.classList.remove('hidden');
      statusBanner.className = "bg-white border-2 border-teal-500 rounded-2xl p-6 shadow-xl text-center space-y-4";
      statusBanner.innerHTML = `
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-teal-100 text-teal-600 mb-2">
          <i class="fa-solid fa-award text-2xl"></i>
        </div>
        <h2 class="text-2xl font-bold text-slate-800">Homework Submitted!</h2>
        <p class="text-slate-600 text-sm">Great job, <strong>${name}</strong> (ID: ${id}, ${group}).</p>
        <div class="inline-block bg-teal-50 border border-teal-200 px-6 py-3 rounded-2xl">
          <span class="text-sm font-semibold uppercase text-teal-700 block">Your Score</span>
          <span class="text-3xl font-extrabold text-teal-800">${score} / ${questionsData.length} (${percentage}%)</span>
        </div>
        <p id="googleSheetStatus" class="text-xs text-slate-400">Sending response to instructor's Google Sheet...</p>
      `;

      // Payload to send to Google Sheets
      const payload = {
        timestamp: timestamp,
        name: name,
        studentId: id,
        group: group,
        score: score,
        percentage: percentage + '%',
        answers: JSON.stringify(userAnswers)
      };

      // Send via Fetch API if script URL configured
      if (GOOGLE_SCRIPT_URL && GOOGLE_SCRIPT_URL !== "YOUR_GOOGLE_APPS_SCRIPT_WEB_APP_URL_HERE") {
        try {
          await fetch(GOOGLE_SCRIPT_URL, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          document.getElementById('googleSheetStatus').innerHTML = 
            `<span class="text-emerald-600 font-semibold"><i class="fa-solid fa-circle-check"></i> Recorded in "Homework Check" Google Sheet successfully!</span>`;
        } catch (err) {
          console.error("Submission error:", err);
          document.getElementById('googleSheetStatus').innerHTML = 
            `<span class="text-amber-600"><i class="fa-solid fa-triangle-exclamation"></i> Submitted locally. Sheet connection could not be completed.</span>`;
        }
      } else {
        document.getElementById('googleSheetStatus').innerHTML = 
          `<span class="text-slate-400 italic">(Demo Mode: Configure GOOGLE_SCRIPT_URL in code to save to Google Sheets)</span>`;
      }

      // Highlight correct/incorrect answers visually
      questionsData.forEach(q => {
        const selected = document.querySelector(`input[name="q_${q.id}"]:checked`);
        const val = selected ? parseInt(selected.value) : -1;
        const qBox = document.getElementById(`qContainer_${q.id}`);

        if (val === q.correct) {
          qBox.classList.add('bg-emerald-50/50', 'border-emerald-300');
        } else {
          qBox.classList.add('bg-rose-50/50', 'border-rose-300');
        }
      });

      submitBtn.innerHTML = `<i class="fa-solid fa-check"></i> Completed`;
    }

    // Initialize Page
    window.onload = function() {
      renderQuestions();
    };
  </script>

  <!-- 
  =====================================================================
  GOOGLE APPS SCRIPT CODE (Paste this inside Google Sheet -> Extensions -> Apps Script)
  =====================================================================

  function doPost(e) {
    try {
      var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Homework Check");
      if (!sheet) {
        sheet = SpreadsheetApp.getActiveSpreadsheet().insertSheet("Homework Check");
        sheet.appendRow(["Timestamp", "Full Name", "Student ID", "Group", "Score", "Percentage", "Raw Answers"]);
      }
      
      var data = JSON.parse(e.postData.contents);
      sheet.appendRow([
        data.timestamp,
        data.name,
        data.studentId,
        data.group,
        data.score,
        data.percentage,
        data.answers
      ]);
      
      return ContentService.createTextOutput(JSON.stringify({"result": "success"}))
                           .setMimeType(ContentService.MimeType.JSON);
    } catch(error) {
      return ContentService.createTextOutput(JSON.stringify({"result": "error", "error": error}))
                           .setMimeType(ContentService.MimeType.JSON);
    }
  }
  ===================================================================== 
  -->
</body>
</html>
